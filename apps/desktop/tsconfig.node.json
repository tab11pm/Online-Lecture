{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["../../src/*"]
    },
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "electron.vite.config.ts",
    "scripts/**/*.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/worker/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
