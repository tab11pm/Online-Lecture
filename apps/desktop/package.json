{
  "name": "@online-lecture/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build:native": "node scripts/build-native-sqlite.mjs",
    "predev": "npm run build:native",
    "dev": "electron-vite dev",
    "preview": "vite --config vite.preview.config.ts",
    "prebuild": "npm run build:native",
    "build": "electron-vite build",
    "pack:win": "tsx --tsconfig tsconfig.node.json scripts/package-windows.ts --dir",
    "dist:win": "tsx --tsconfig tsconfig.node.json scripts/package-windows.ts --nsis",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "start": "electron-vite preview"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^12.6.2",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.59.0",
    "playwright": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sdo_mcp": "github:tab11pm/sdo-mcp#v1.2.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
