# Copy to .env and fill in the values you need.
# The CLI loads .env automatically on startup (missing file is fine).

# How to start the SDO MCP server. This is a command line: the first token is
# the executable, the rest are arguments. Examples:
#   SDO_MCP_SERVER_PATH=node /path/to/sdo_mcp/dist/index.js
#   SDO_MCP_SERVER_PATH=npm run dev        # requires SDO_MCP_SERVER_CWD
# If unset, the app runs the installed sdo_mcp package (node_modules) through
# its own Node, then ~/.local/bin/sdo-mcp when it exists, else "sdo-mcp" on PATH.
SDO_MCP_SERVER_PATH=

# Working directory for the MCP server. Required when the server loads its own
# .env or resolves npm scripts from its project directory.
SDO_MCP_SERVER_CWD=

# MCP connection timeout in milliseconds (MCP_TIMEOUT_MS is also accepted).
SDO_MCP_CONNECTION_TIMEOUT=5000

# Playwright storage state with the shared TUSUR SSO session.
# Read by the SDO MCP server itself; our timetable fetcher takes its path via --auth-state.
SDO_AUTH_STATE_PATH=

# Browser channel the SDO MCP server launches (for example msedge). The desktop
# app uses msedge on Windows when this is not set; leave it empty to use
# Playwright's own Chromium (requires `npx playwright install chromium`).
# SDO_BROWSER_CHANNEL=
